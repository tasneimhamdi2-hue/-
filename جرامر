    let currentQ = 0;
    let score = 0;
    let studentName = "";
    let studentClass = "";

    function startGame() {
        studentName = document.getElementById('student-name').value.trim();
        studentClass = document.getElementById('student-class').value.trim();

        if(!studentName || !studentClass) {
            alert('يرجى كتابة الاسم والصف لبدء اللعبة!');
            return;
        }

        document.getElementById('screen-start').classList.add('hidden');
        document.getElementById('progress-container').classList.remove('hidden');
        document.getElementById('screen-quiz').classList.remove('hidden');
        document.getElementById('screen-quiz').classList.add('flex');
        
        showQuestion();
    }

    function showQuestion() {
        const q = questionsBank[currentQ];
        document.getElementById('question-text').innerText = q.text;
        
        // Update Stage Badge
        const badge = document.getElementById('stage-badge');
        if(currentQ < 15) badge.innerText = "المرحلة 1: التذكر (Remembering)";
        else if(currentQ < 35) badge.innerText = "المرحلة 2: الفهم (Understanding)";
        else if(currentQ < 65) badge.innerText = "المرحلة 3: التطبيق (Applying)";
        else if(currentQ < 85) badge.innerText = "المرحلة 4: التحليل (Analyzing)";
        else if(currentQ < 95) badge.innerText = "المرحلة 5: التقييم (Evaluating)";
        else badge.innerText = "المرحلة 6: التميز والتركيب (Creating)";

        // Progress Bar
        const progress = ((currentQ + 1) / questionsBank.length) * 100;
        document.getElementById('progress-bar').style.width = progress + '%';

        // Options
        const container = document.getElementById('options-container');
        container.innerHTML = '';
        document.getElementById('feedback-box').classList.add('hidden');
        document.getElementById('btn-next').classList.add('hidden');

        q.options.forEach((opt, idx) => {
            const btn = document.createElement('button');
            btn.className = 'w-full text-left p-4 rounded-xl border-2 border-slate-200 hover:border-indigo-500 hover:bg-indigo-50/50 font-semibold text-slate-700 transition duration-200 flex items-center justify-between group';
            btn.innerHTML = `<span>${opt}</span><span class="opacity-0 group-hover:opacity-100 transition">👉</span>`;
            btn.onclick = () => checkAnswer(idx);
            container.appendChild(btn);
        });
    }

    function checkAnswer(selectedIdx) {
        const q = questionsBank[currentQ];
        const options = document.querySelectorAll('#options-container button');
        
        options.forEach(opt => opt.disabled = true);

        const feedbackBox = document.getElementById('feedback-box');
        const feedbackTitle = document.getElementById('feedback-title');
        const feedbackText = document.getElementById('feedback-text');

        if(selectedIdx === q.correct) {
            options[selectedIdx].className = "w-full text-left p-4 rounded-xl border-2 border-teal-500 bg-teal-50 text-teal-900 font-bold flex items-center justify-between";
            options[selectedIdx].innerHTML += `<span>✓</span>`;
            score++;
            document.getElementById('score-val').innerText = score;
            
            feedbackBox.className = "p-4 rounded-2xl border text-right transition-all duration-300 mb-6 bg-teal-50 border-teal-200 text-teal-900";
            feedbackTitle.innerText = "✨ إجابة صحيحة! أحسنت العمل.";
        } else {
            options[selectedIdx].className = "w-full text-left p-4 rounded-xl border-2 border-rose-500 bg-rose-50 text-rose-900 font-bold flex items-center justify-between";
            options[selectedIdx].innerHTML += `<span>✗</span>`;
            
            options[q.correct].className = "w-full text-left p-4 rounded-xl border-2 border-teal-500 bg-teal-50 text-teal-900 font-bold flex items-center justify-between";
            options[q.correct].innerHTML += `<span>✓</span>`;

            feedbackBox.className = "p-4 rounded-2xl border text-right transition-all duration-300 mb-6 bg-rose-50 border-rose-200 text-rose-900";
            feedbackTitle.innerText = "❌ إجابة خاطئة!";
        }

        feedbackText.innerText = q.explanation;
        feedbackBox.classList.remove('hidden');
        document.getElementById('btn-next').classList.remove('hidden');
    }

    function nextQuestion() {
        currentQ++;
        if(currentQ < questionsBank.length) {
            showQuestion();
        } else {
            finishGame();
        }
    }

    function finishGame() {
        document.getElementById('screen-quiz').classList.add('hidden');
        document.getElementById('progress-container').classList.add('hidden');
        
        document.getElementById('screen-certificate').classList.remove('hidden');
        document.getElementById('screen-certificate').classList.add('flex');

        document.getElementById('cert-name').innerText = studentName;
        document.getElementById('cert-class').innerText = studentClass;
        document.getElementById('cert-score').innerText = score;
        
        const today = new Date();
        document.getElementById('cert-date').innerText = today.toLocaleDateString('ar-EG');
    }
</script>
